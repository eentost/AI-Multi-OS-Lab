{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eentost.github.io/AI-Multi-OS-Lab/schemas/vm-blueprint.schema.json",
  "title": "AI Multi-OS Lab VM Blueprint",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "os", "architecture", "hardware", "network_profile"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "os": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "version"],
      "properties": {
        "family": { "type": "string", "enum": ["windows", "linux", "freebsd"] },
        "distribution": { "type": "string", "maxLength": 64 },
        "version": { "type": "string", "minLength": 1, "maxLength": 32 }
      }
    },
    "architecture": { "type": "string", "enum": ["x86_64", "aarch64", "armv7"] },
    "worker_selector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preferred_hypervisor": { "type": "string", "enum": ["kvm", "hyperv", "qemu-tcg"] },
        "required_capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vcpus", "memory_mb", "disk_gb"],
      "properties": {
        "vcpus": { "type": "integer", "minimum": 1, "maximum": 64 },
        "memory_mb": { "type": "integer", "minimum": 1024, "maximum": 262144 },
        "disk_gb": { "type": "integer", "minimum": 16, "maximum": 4096 },
        "firmware": { "type": "string", "enum": ["bios", "uefi"], "default": "uefi" },
        "tpm": { "type": "boolean", "default": false },
        "secure_boot": { "type": "boolean", "default": false }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resolution": { "type": "string", "pattern": "^[0-9]{3,5}x[0-9]{3,5}$" },
        "protocol": { "type": "string", "enum": ["rdp", "vnc", "spice", "auto"] }
      }
    },
    "network_profile": { "type": "string", "enum": ["AIRGAP", "ISOLATED", "SIMULATED", "CONTROLLED_EGRESS"] },
    "integrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent_desktop": { "type": "boolean", "default": false },
        "guest_telemetry": { "type": "boolean", "default": false },
        "clipboard": { "type": "boolean", "default": false },
        "shared_folder": { "type": "boolean", "default": false }
      }
    }
  }
}